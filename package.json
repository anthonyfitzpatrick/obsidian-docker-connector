{
  "name": "obsidian-docker-connector",
  "version": "1.1.4",
  "description": "A desktop Docker environment dashboard with optional, explicitly enabled container management.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "release:check": "npm run build && node tools/verify-release.mjs",
    "test": "vitest run tests",
    "lint": "tsc --noEmit && eslint src"
  },
  "keywords": [
    "obsidian",
    "docker",
    "dashboard"
  ],
  "author": "Wolf 359 Press AB",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/ssh2": "^1.15.5",
    "esbuild": "^0.24.0",
    "eslint": "^10.9.1",
    "obsidian": "latest",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  }
}
